<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	<IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
	<IsPackable>true</IsPackable>
	<PackageId>Ama.CRDT</PackageId>
	<Version>0.1.0</Version>
	<Authors>Alexander Mantzoukas</Authors>
	<Description>A .NET library for implementing Conflict-free Replicated Data Types (CRDTs) to enable real-time collaborative applications and distributed systems.</Description>
	<RepositoryUrl>https://github.com/phaetto/Ama.CRDT</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageTags>crdt;distributed-systems;collaboration;conflict-free</PackageTags>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	
	<!-- SourceLink and Symbol Configuration -->
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	
	<!-- Generate XML documentation file -->
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<!-- Suppress warning for missing comments on internal/private members -->
	<NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
	  <ProjectReference Include="..\Ama.CRDT.Analyzers\Ama.CRDT.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	  <ProjectReference Include="..\Ama.CRDT.Project.Analyzers\Ama.CRDT.Project.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	  <ProjectReference Include="..\Ama.CRDT.SourceGenerators\Ama.CRDT.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
	<!-- SourceLink Package -->
	<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" PrivateAssets="All" />
	<!-- Public API Analyzer -->
	<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
  </ItemGroup>
  
  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
	<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
	<PackageReference Include="System.Collections.Immutable" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
	  <None Include="..\Ama.CRDT.Analyzers\bin\$(Configuration)\netstandard2.0\Ama.CRDT.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	  <None Include="..\Ama.CRDT.SourceGenerators\bin\$(Configuration)\netstandard2.0\Ama.CRDT.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <Target Name="VerifyAnalyzersExistBeforePack" BeforeTargets="GenerateNuspec">
	  <Error Condition="!Exists('..\Ama.CRDT.Analyzers\bin\$(Configuration)\netstandard2.0\Ama.CRDT.Analyzers.dll')" Text="Ama.CRDT.Analyzers.dll was not found at '..\Ama.CRDT.Analyzers\bin\$(Configuration)\netstandard2.0\Ama.CRDT.Analyzers.dll'. Ensure the analyzer project is built before packing." />
	  <Error Condition="!Exists('..\Ama.CRDT.SourceGenerators\bin\$(Configuration)\netstandard2.0\Ama.CRDT.SourceGenerators.dll')" Text="Ama.CRDT.SourceGenerators.dll was not found at '..\Ama.CRDT.SourceGenerators\bin\$(Configuration)\netstandard2.0\Ama.CRDT.SourceGenerators.dll'. Ensure the source generator project is built before packing." />
  </Target>

</Project>